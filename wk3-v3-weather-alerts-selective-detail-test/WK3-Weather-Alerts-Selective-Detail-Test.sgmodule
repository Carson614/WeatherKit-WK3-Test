#!name = WK3 Weather Alerts Selective Detail Test
#!desc = Isolated per-alert detail routing experiment. Strictly matched alert summaries may use a one-event QWeather detail route; unmatched Apple alerts and the shared collection link remain unchanged.
#!author = Carson614; based on NSRingo WeatherKit (Apache-2.0)
#!homepage = https://github.com/Carson614/WeatherKit-WK3-Test/tree/wk3-weather-alerts-selective-detail-test-20261107/wk3-v3-weather-alerts-selective-detail-test
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-11-07
#!version = minfix-us-aqi-next-hour-weather-alerts-selective-detail-test-2026.11.07-r1
#!arguments = DataSets:"airQuality,forecastNextHour,weatherAlerts",NextHour.Provider:"ColorfulClouds",Weather.Replace:"CN",WeatherAlerts.Provider:"QWeatherWeb",AirQuality.Current.Pollutants.Provider:"ColorfulClouds",AirQuality.Current.Pollutants.Units.Replace:"",AirQuality.Current.Pollutants.Units.Mode:"Scale",AirQuality.Current.Index.Replace:"HJ6332012,EU.EAQI,CN_AQHI,EPA_NowCast",AirQuality.Current.Index.Provider:"ColorfulCloudsUS",AirQuality.Current.Index.ForceCNPrimaryPollutants:true,AirQuality.Comparison.ReplaceWhenCurrentChange:true,AirQuality.Comparison.Yesterday.IndexProvider:"ColorfulCloudsUS",API.ColorfulClouds.Token:"",Storage:"Argument",LogLevel:"OFF"
#!arguments-desc = Independent switches: set NextHour.Provider=WeatherKit to disable minute rain; set WeatherAlerts.Provider=WeatherKit to disable alert matching. When an alert batch is only partly matched, rewrite only summaries that already contain their own per-alert detailsUrl; retain the shared collection URL and every unmatched Apple event. The native details payload contains only the matched original Apple event ID. Type, region, verified severity, exact issue time, active lifecycle and unique candidate checks remain strict.

[Script]
WeatherKit MinFix US AQI scale request = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/561d4e8d372d5e2801df8639d49e53833b3b150b/wk3-v3-weather-alerts-selective-detail-test/request.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
WeatherKit MinFix US AQI + Next Hour + Weather Alerts Selective Detail response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/561d4e8d372d5e2801df8639d49e53833b3b150b/wk3-v3-weather-alerts-selective-detail-test/response.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
WeatherKit WK3 Native Alert Details request = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/weatherAlerts\?(?:[^#]*&)?ids=wk3_[A-Za-z0-9_-]+(?:&[^#]*)?$, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/561d4e8d372d5e2801df8639d49e53833b3b150b/wk3-v3-weather-alerts-selective-detail-test/request.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com, api.caiyunapp.com, www.qweather.com
