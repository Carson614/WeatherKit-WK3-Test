#!name = WK2 Watch AQI Companion Test
#!desc = 独立 WK2 AQI 补入实验；仅处理明确请求 airQuality、country=CN 的有效 WK2 Weather 响应，未知或失败时恢复 Apple 原始字节。
#!author = Carson614; based on NSRingo WeatherKit (Apache-2.0)
#!homepage = https://github.com/Carson614/WeatherKit-WK3-Test/tree/wk2-watch-aqi-companion-test-20261108/wk2-watch-aqi-companion-test-20261108
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-11-08
#!version = wk2-watch-aqi-companion-test-2026.11.08-r1
#!arguments = DataSets:"airQuality",AirQuality.Current.Pollutants.Provider:"ColorfulClouds",AirQuality.Current.Pollutants.Units.Replace:"",AirQuality.Current.Pollutants.Units.Mode:"Scale",AirQuality.Current.Index.Replace:"HJ6332012,EU.EAQI,CN_AQHI,EPA_NowCast",AirQuality.Current.Index.Provider:"ColorfulCloudsUS",AirQuality.Current.Index.ForceCNPrimaryPollutants:true,AirQuality.Comparison.ReplaceWhenCurrentChange:true,AirQuality.Comparison.Yesterday.IndexProvider:"ColorfulCloudsUS",Storage:"Argument",LogLevel:"OFF"
#!arguments-desc = AQI-only WK2 companion. Existing Apple AQI products are kept byte-for-byte. New AQI data is accepted only when EPA_NowCast.2604, index/category, source freshness, and source coordinates validate. DataSets is fixed to airQuality. This module does not handle v1/v3, availability, alerts, rain, or snow.

[Script]
WK2 Watch AQI Companion response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/0000000000000000000000000000000000000000/wk2-watch-aqi-companion-test-20261108/response.bundle.js, argument=DataSets="{{{DataSets}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com, api.caiyunapp.com
