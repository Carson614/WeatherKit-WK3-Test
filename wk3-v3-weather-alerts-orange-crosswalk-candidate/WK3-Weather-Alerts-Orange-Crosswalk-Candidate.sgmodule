#!name = WK3 Weather Alerts Orange Crosswalk Candidate
#!desc = Independent candidate after Tangshan three-alert iPhone verification. WK3 raw2→Severe remains inferred, not an Apple protocol definition.
#!author = Carson614; based on NSRingo WeatherKit (Apache-2.0)
#!homepage = https://github.com/Carson614/WeatherKit-WK3-Test/tree/wk3-weather-alerts-orange-crosswalk-candidate-20261107/wk3-v3-weather-alerts-orange-crosswalk-candidate
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-11-07
#!version = minfix-us-aqi-next-hour-weather-alerts-orange-crosswalk-candidate-2026.11.08-r1
#!arguments = DataSets:"airQuality,forecastNextHour,weatherAlerts",NextHour.Provider:"ColorfulClouds",Weather.Replace:"CN",WeatherAlerts.Provider:"QWeatherWeb",AirQuality.Current.Pollutants.Provider:"ColorfulClouds",AirQuality.Current.Pollutants.Units.Replace:"",AirQuality.Current.Pollutants.Units.Mode:"Scale",AirQuality.Current.Index.Replace:"HJ6332012,EU.EAQI,CN_AQHI,EPA_NowCast",AirQuality.Current.Index.Provider:"ColorfulCloudsUS",AirQuality.Current.Index.ForceCNPrimaryPollutants:true,AirQuality.Comparison.ReplaceWhenCurrentChange:true,AirQuality.Comparison.Yesterday.IndexProvider:"ColorfulCloudsUS",API.ColorfulClouds.Token:"",Storage:"Argument",LogLevel:"OFF"
#!arguments-desc = Independent switches: set NextHour.Provider=WeatherKit to disable minute rain; set WeatherAlerts.Provider=WeatherKit to disable alert matching. Experimental mapping only: raw2→Severe is inferred for eligible national orange alerts; red remains fail-closed. All Apple alerts must match before the shared native API route is rewritten. Raw2 remains unconfirmed as an Apple protocol definition.

[Script]
WeatherKit MinFix US AQI scale request = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/25a27bb87392af103771a7d6d1065b316c72da28/wk3-v3-weather-alerts-orange-crosswalk-candidate/request.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
WeatherKit MinFix US AQI + Next Hour + Weather Alerts Orange Crosswalk Candidate response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/25a27bb87392af103771a7d6d1065b316c72da28/wk3-v3-weather-alerts-orange-crosswalk-candidate/response.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
WeatherKit WK3 Native Alert Details request = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v[12]\/weatherAlerts\?(?:[^#]*&)?ids=wk3_[A-Za-z0-9_-]+(?:&[^#]*)?$, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/25a27bb87392af103771a7d6d1065b316c72da28/wk3-v3-weather-alerts-orange-crosswalk-candidate/request.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&WeatherAlerts.Provider="{{{WeatherAlerts.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

