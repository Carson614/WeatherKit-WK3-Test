#!name = WK3 Next Hour Root Rebuild Test
#!desc = Isolated WK3 b66 minute-forecast experiment. Rebuilds root slot 5 only after validating the serialized root and all existing table pointers.
#!author = Carson614; based on NSRingo WeatherKit
#!homepage = https://github.com/Carson614/WeatherKit-WK3-Test/tree/wk3-next-hour-root-rebuild-test-20261107/wk3-v3-next-hour-root-rebuild-test
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-11-07
#!version = minfix-us-aqi-next-hour-root-rebuild-2026.11.07-r1
#!arguments = DataSets:"airQuality,forecastNextHour",NextHour.Provider:"ColorfulClouds",Weather.Replace:"CN",AirQuality.Current.Pollutants.Provider:"ColorfulClouds",AirQuality.Current.Pollutants.Units.Replace:"",AirQuality.Current.Pollutants.Units.Mode:"Scale",AirQuality.Current.Index.Replace:"HJ6332012,EU.EAQI,CN_AQHI,EPA_NowCast",AirQuality.Current.Index.Provider:"ColorfulCloudsUS",AirQuality.Current.Index.ForceCNPrimaryPollutants:true,AirQuality.Comparison.ReplaceWhenCurrentChange:true,AirQuality.Comparison.Yesterday.IndexProvider:"ColorfulCloudsUS",API.ColorfulClouds.Token:"",Storage:"Argument",LogLevel:"OFF"
#!arguments-desc = Test only. Set NextHour.Provider to WeatherKit to disable minute-forecast injection while retaining AQI. Inspect X-WK3-NextHour-Diag for the root-slot, source, and result states. LogLevel defaults to OFF; the response header contains only short status codes. Structural validation failures return the original WeatherKit bytes. No weather-alert feature is included.

[Script]
WeatherKit MinFix US AQI scale request = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/1d9494476772b5d8e12b5bedc349cb6e08a639ac/wk3-v3-next-hour-root-rebuild-test/request.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
WeatherKit MinFix US AQI + Next Hour root rebuild response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/1d9494476772b5d8e12b5bedc349cb6e08a639ac/wk3-v3-next-hour-root-rebuild-test/response.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com, api.caiyunapp.com
