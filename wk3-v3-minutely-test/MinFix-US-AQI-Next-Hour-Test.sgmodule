#!name = iRingo WeatherKit MinFix US AQI + Next Hour Test
#!desc = Isolated iOS 27 WK3 experiment: stable MinFix US AQI plus opt-in-by-argument ColorfulClouds minute precipitation.
#!openUrl = http://boxjs.com/#/app/iRingo.WeatherKit.beta
#!author = Carson614; based on NSRingo WeatherKit
#!homepage = https://github.com/Carson614/WeatherKit-WK3-Test/tree/minfix-us-aqi-next-hour-test-20261106/wk3-v3-minutely-test
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-11-06
#!version = minfix-us-aqi-next-hour-2026.11.06
#!arguments = DataSets:"airQuality,forecastNextHour",NextHour.Provider:"ColorfulClouds",Weather.Replace:"CN",AirQuality.Current.Pollutants.Provider:"ColorfulClouds",AirQuality.Current.Pollutants.Units.Replace:"",AirQuality.Current.Pollutants.Units.Mode:"Scale",AirQuality.Current.Index.Replace:"HJ6332012,EU.EAQI,CN_AQHI,EPA_NowCast",AirQuality.Current.Index.Provider:"ColorfulCloudsUS",AirQuality.Current.Index.ForceCNPrimaryPollutants:true,AirQuality.Comparison.ReplaceWhenCurrentChange:true,AirQuality.Comparison.Yesterday.IndexProvider:"ColorfulCloudsUS",API.ColorfulClouds.Token:"",Storage:"Argument",LogLevel:"WARN"
#!arguments-desc = DataSets defaults to airQuality,forecastNextHour. Set NextHour.Provider to WeatherKit to isolate AQI; restore ColorfulClouds to test minutes. No weather-alert script is enabled.

[Script]
WeatherKit MinFix US AQI scale request = type=http-request, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/93d1fa481bbc7dbb0f4c3ded7447727c9b816362/wk3-v3-minutely-test/request.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"
WeatherKit MinFix US AQI + Next Hour response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v3\/weather\/, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://raw.githubusercontent.com/Carson614/WeatherKit-WK3-Test/93d1fa481bbc7dbb0f4c3ded7447727c9b816362/wk3-v3-minutely-test/response.dev.bundle.js, argument=DataSets="{{{DataSets}}}"&Weather.Replace="{{{Weather.Replace}}}"&NextHour.Provider="{{{NextHour.Provider}}}"&AirQuality.Current.Pollutants.Provider="{{{AirQuality.Current.Pollutants.Provider}}}"&AirQuality.Current.Pollutants.Units.Replace="{{{AirQuality.Current.Pollutants.Units.Replace}}}"&AirQuality.Current.Pollutants.Units.Mode="{{{AirQuality.Current.Pollutants.Units.Mode}}}"&AirQuality.Current.Index.Replace="{{{AirQuality.Current.Index.Replace}}}"&AirQuality.Current.Index.Provider="{{{AirQuality.Current.Index.Provider}}}"&AirQuality.Current.Index.ForceCNPrimaryPollutants="{{{AirQuality.Current.Index.ForceCNPrimaryPollutants}}}"&AirQuality.Comparison.ReplaceWhenCurrentChange="{{{AirQuality.Comparison.ReplaceWhenCurrentChange}}}"&AirQuality.Comparison.Yesterday.IndexProvider="{{{AirQuality.Comparison.Yesterday.IndexProvider}}}"&API.ColorfulClouds.Token="{{{API.ColorfulClouds.Token}}}"&Storage="{{{Storage}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% weatherkit.apple.com, api.caiyunapp.com
